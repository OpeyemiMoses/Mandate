# MANDATE — PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# For deployment to Vercel (Frontend & Serverless API) and Railway (PostgreSQL & Execution Workers)

# Environment & Network
NODE_ENV="production"
NEAR_NETWORK="testnet"
NEXT_PUBLIC_NEAR_NETWORK="testnet"
NEXT_PUBLIC_APP_URL="https://mandate.network"

# PostgreSQL 18.6 Database
# For Railway PostgreSQL: automatically injected as DATABASE_URL
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@YOUR_RAILWAY_HOST:5432/mandate_prod?schema=public"
MANDATE_DATABASE_TYPE="postgres"

# OutLayer Managed Intel SGX TEE
OUTLAYER_API_URL="https://api.outlayer.fastnear.com"
OUTLAYER_API_KEY="wk_YOUR_OUTLAYER_WORKER_KEY"
OUTLAYER_EXECUTOR_ACCOUNT_ID="04fdfed3a43cd4475e3928457354d51737a5f67e865c540bf4cd35d19b1f724a"
NEXT_PUBLIC_OUTLAYER_WALLET_ADDRESS="04fdfed3a43cd4475e3928457354d51737a5f67e865c540bf4cd35d19b1f724a"

# Cryptographic Execution Boundary & Ticket Sealing
EXECUTION_SIGNING_SECRET="YOUR_64_CHAR_HEXADECIMAL_SECRET_KEY"
SESSION_SECRET="YOUR_64_CHAR_HEXADECIMAL_SESSION_SECRET"
INTERNAL_SERVICE_SECRET="YOUR_64_CHAR_HEXADECIMAL_INTERNAL_SECRET"
CREDENTIAL_VAULT_KEY_V1="YOUR_64_CHAR_HEXADECIMAL_VAULT_KEY"
TOOL_ENCRYPTION_KEY="YOUR_64_CHAR_HEXADECIMAL_TOOL_KEY"
MANDATE_API_KEY="mnd_YOUR_ADMIN_API_KEY"

# Operational Controls
MANDATE_PLATFORM_FROZEN="false"
MANDATE_ENABLE_MAINNET="false"
