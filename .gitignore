# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing & scratch scripts
tests/
take-screenshots.js
test-cdp-shots.js
scripts/capture-all-views.js
coverage/

# internal milestone, audit & planning reports
/*.md
!/README.md
!/CODE_OF_CONDUCT.md
!/CONTRIBUTING.md
!/SECURITY.md
docs/milestones/
docs/operations/
docs/reports/
docs/security/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# databases & backups
prisma/*.db*
prisma/backups/
*.sqlite*
data/
data/**

# local screenshots
shots-*.png
*-shot*.png
test-*.png

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
